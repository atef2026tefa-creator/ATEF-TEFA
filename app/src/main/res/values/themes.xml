<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- AppCompatActivity requires an AppCompat theme; Compose handles the UI styling. -->
    <style name="Theme.CostAppPro" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:statusBarColor">@color/brand_background_dark</item>
        <item name="android:windowBackground">@color/brand_background_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Splash screen theme used by androidx.core.splashscreen -->
    <style name="Theme.CostAppPro.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="windowSplashScreenAnimationDuration">200</item>
        <item name="postSplashScreenTheme">@style/Theme.CostAppPro</item>
    </style>
</resources>
